<?xml version="1.0" encoding="utf-8"?>
<!--
  Shipped next to Frosthaven Companion.exe by build.ps1 (never inside _internal: .NET Framework reads the process's own
  <exe>.config for the default domain, and clr_loader cannot set the root domain's config any other way).

  Why: a zip downloaded with a browser carries Windows' download mark (Zone.Identifier, ZoneId=3), and
  Explorer's Extract All copies that mark onto every file it unpacks. .NET Framework then refuses to load the
  marked pythonnet and WebView2 assemblies (0x80131515), `import clr` fails and the companion window never
  opens. loadFromRemoteSources lets this process load its own bundled assemblies anyway. Reproduced
  2026-09-23: no config fails, a config without the switch fails, a marked config with the switch works
  (found on MnM Meter).
-->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>
